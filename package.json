{
  "name": "tionport-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-pages.mjs && vite",
    "build": "node scripts/generate-pages.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build && npm run verify",
